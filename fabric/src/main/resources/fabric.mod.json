{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "frankV"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/journeymap-integration",
    "sources": "https://github.com/frank89722/JourneyMapIntegration"
  },
  "license": "${license}",
  "icon": "assets/jmi/logo.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "me.frankv.jmi.JMIFabric"
    ],
